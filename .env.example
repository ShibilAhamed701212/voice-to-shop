# Copy to .env (done automatically by `npm install` at the repo root).
# Everything is optional — without keys the app uses the built-in agent and browser speech.

# API port
PORT=8000

# Claude AI agent (natural conversation). Without it the offline rule-based agent is used.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Make.com Custom Webhook for the "Make.com AI Agent" mode (see make/README.md).
# Must return JSON with a "text" field via a Webhook Response module.
MAKE_WEBHOOK_URL=

# ElevenLabs speech-to-text / text-to-speech (kept server-side, never sent to the browser).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Timezone used for "today", slot lead times and the booking window.
APP_TIMEZONE=Asia/Kolkata

# Where runtime booking data is written (defaults to mock-api/data/runtime).
# DATA_DIR=

# Allow POST /api/admin/reset when NODE_ENV=production.
# ALLOW_RESET=true
